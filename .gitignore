# ==============================================================================
# GitIgnore for C++ / Visual Studio / CMake / wxWidgets Projects
# ==============================================================================

# IDE and Editor files
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.opendb
*.db

# Build output directories
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
build/
cmake-build-*/
out/

# Visual Studio intermediate / compiler files
*.obj
*.ilk
*.tlog
*.idb
*.pdb
*.ipdb
*.iobj
*.pch
*.res
*.aps
*.recipe
*.lastbuildstate
*.log
*.unsuccessfulbuild
*.secondary.1.tlog

# Executables, libraries, binaries
*.exe
*.dll
*.so
*.dylib
*.lib
*.a

# Package managers
vcpkg_installed/
installed/

# Operating System files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.DS_Store

# Temporary and backup files
*.tmp
*.bak
*~
*.swp
